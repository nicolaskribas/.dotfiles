# https://aur.archlinux.org/packages/pacman-cleanup-hook
# --cachedir: never run --uninstalled on the aurutils repo, it would delete files custom.db still lists
# --keep 1: a removed package can be reinstalled from the cache; maintenance asks before deleting it

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Removing old cached package files of uninstalled packages (keeping one)...
Exec = /usr/bin/paccache --remove --verbose --uninstalled --keep 1 --cachedir /var/cache/pacman/pkg
When = PostTransaction
Depends = pacman-contrib

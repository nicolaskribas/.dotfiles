# https://github.com/nix-community/home-manager/blob/master/modules/services/easyeffects.nix

[Unit]
Description=EasyEffects Service
Documentation=https://wwmm.github.io/easyeffects
Requires=dbus.service
After=graphical-session.target pipewire.service
PartOf=graphical-session.target pipewire.service

[Service]
Type=exec
ExecStart=/usr/bin/easyeffects --service-mode --hide-window
ExecStop=/usr/bin/easyeffects --quit
Restart=on-failure
RestartSec=5
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
